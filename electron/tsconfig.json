{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist-electron",
    "module": "commonjs",
    "types": [
      "node",
      "electron"
    ]
  },
  "include": [
    "./**/*.ts",
    "../src/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "../dist-electron",
    "../src/__tests__",
    "../src/__mocks__"
  ]
}