{
  "name": "opendevbot",
  "version": "0.9.0",
  "description": "a twitch chatbot for multiple channels using twurple",
  "author": "SkullGaming31",
  "license": "MIT",
  "scripts": {
    "start": "node ./dist/index.js",
    "start:dev": "nodemon ./src/index.ts",
    "start:prod": "tsc && node ./dist/index.js",
    "build": "tsc",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build && electron ./dist-electron/electron/main.js",
    "electron:start": "electron ./dist-electron/electron/main.js",
    "test": "jest --coverage=false",
    "test:coverage": "jest --coverage",
    "lint": "eslint --fix src",
    "watch": "tsc -w",
    "typecheck": "tsc -p tsconfig.jest.json --noEmit",
    "seed-db": "ts-node ./src/scripts/seedDatabase.ts"
  },
  "keywords": [],
  "dependencies": {
    "@twurple/api": "^8.1.4",
    "@twurple/auth": "^8.1.4",
    "@twurple/chat": "^8.1.4",
    "@twurple/eventsub-ws": "^8.1.4",
    "axios": "^1.16.1",
    "countdown": "^2.6.0",
    "discord-api-types": "^0.38.47",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsondiffpatch": "^0.7.6",
    "mongoose": "^9.6.2",
    "ms": "^2.1.3",
    "oauth": "^0.10.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/cookiejar": "^2.1.5",
    "@types/countdown": "^0.0.8",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/oauth": "^0.9.6",
    "@types/superagent": "^8.1.9",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.5.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "directory": "private",
    "type": "git",
    "url": "https://github.com/SkullGaming31/opendevbot"
  },
  "bugs": {
    "url": "https://github.com/SkullGaming31/opendevbot/issues",
    "email": "skullgamingg31@gmail.com"
  }
}